        <mxCell id="score_tbl" value="&lt;table style='width:1536px;border-collapse:collapse;font-family:Inter,Arial,sans-serif;font-size:12.5px;color:#0F172A;'&gt;&lt;thead&gt;&lt;tr style='background:#1E3A8A;color:#FFFFFF;font-weight:800;'&gt;&lt;th style='padding:12px 16px;text-align:left;border:1px solid #475569;width:450px;'&gt;Architectural Fitness Criterion&lt;/th&gt;&lt;th style='padding:12px 10px;text-align:center;border:1px solid #475569;width:110px;'&gt;Weight&lt;/th&gt;&lt;th style='padding:12px 12px;text-align:center;border:1px solid #475569;width:300px;'&gt;Option A (Monolith)&lt;/th&gt;&lt;th style='padding:12px 12px;text-align:center;border:1px solid #475569;width:376px;background:#15803D;'&gt;Option B (SELECTED — Cloud Run + AlloyDB AI)&lt;/th&gt;&lt;th style='padding:12px 12px;text-align:center;border:1px solid #475569;width:300px;'&gt;Option C (Spanner Active-Active)&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style='background:#FFFFFF;'&gt;&lt;td style='padding:11px 16px;border:1px solid #94A3B8;font-weight:700;text-align:left;'&gt;Tenant Isolation, Blast Radius &amp;amp; RPO/RTO&lt;/td&gt;&lt;td style='padding:11px 10px;border:1px solid #94A3B8;font-weight:700;text-align:center;'&gt;(25%)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;2.0 / 5.0&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;font-weight:800;color:#14532D;background:#F0FDF4;'&gt;4.8 / 5.0 (VPC-SC + RLS)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;5.0 / 5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#EFF6FF;'&gt;&lt;td style='padding:11px 16px;border:1px solid #94A3B8;font-weight:700;text-align:left;'&gt;Hybrid Vector RAG &amp;amp; Agent Tool Latency&lt;/td&gt;&lt;td style='padding:11px 10px;border:1px solid #94A3B8;font-weight:700;text-align:center;'&gt;(20%)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;3.5 / 5.0&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;font-weight:800;color:#14532D;background:#DCFCE7;'&gt;4.9 / 5.0 (AlloyDB ScaNN)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;3.4 / 5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF;'&gt;&lt;td style='padding:11px 16px;border:1px solid #94A3B8;font-weight:700;text-align:left;'&gt;Deployment Velocity &amp;amp; Serverless Autoscaling&lt;/td&gt;&lt;td style='padding:11px 10px;border:1px solid #94A3B8;font-weight:700;text-align:center;'&gt;(20%)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;2.8 / 5.0&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;font-weight:800;color:#14532D;background:#F0FDF4;'&gt;4.8 / 5.0 (Cloud Run Gen2)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;2.5 / 5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#EFF6FF;'&gt;&lt;td style='padding:11px 16px;border:1px solid #94A3B8;font-weight:700;text-align:left;'&gt;FinOps Unit Cost ($ / 1k Agent Sessions)&lt;/td&gt;&lt;td style='padding:11px 10px;border:1px solid #94A3B8;font-weight:700;text-align:center;'&gt;(20%)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;4.5 / 5.0&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;font-weight:800;color:#14532D;background:#DCFCE7;'&gt;4.3 / 5.0 ($0.07 / session)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;1.8 / 5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF;'&gt;&lt;td style='padding:11px 16px;border:1px solid #94A3B8;font-weight:700;text-align:left;'&gt;SRE Operational Simplicity &amp;amp; Maintainability&lt;/td&gt;&lt;td style='padding:11px 10px;border:1px solid #94A3B8;font-weight:700;text-align:center;'&gt;(15%)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;3.0 / 5.0&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;font-weight:800;color:#14532D;background:#F0FDF4;'&gt;4.7 / 5.0 (Managed PaaS)&lt;/td&gt;&lt;td style='padding:11px 12px;border:1px solid #94A3B8;text-align:center;'&gt;2.1 / 5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E3A8A;color:#FFFFFF;font-weight:800;font-size:13px;'&gt;&lt;td colspan='2' style='padding:13px 16px;border:1px solid #475569;text-align:left;'&gt;Weighted Fitness Score (100% Total Weight)&lt;/td&gt;&lt;td style='padding:13px 12px;border:1px solid #475569;text-align:center;'&gt;Option A: 3.11 / 5.00&lt;/td&gt;&lt;td style='padding:13px 12px;border:1px solid #475569;text-align:center;background:#15803D;'&gt;Option B: 4.71 / 5.00 &amp;#9989; (SELECTED WINNER)&lt;/td&gt;&lt;td style='padding:13px 12px;border:1px solid #475569;text-align:center;'&gt;Option C: 3.10 / 5.00&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#0F172A;fontFamily=Inter,Arial,sans-serif;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="444" width="1536" height="372" as="geometry"/></mxCell>
        <mxCell id="adr_signoff" value="&lt;table style='width:1512px;border-collapse:collapse;font-family:Inter,Arial,sans-serif;font-size:11px;color:#0F172A;'&gt;&lt;tr&gt;&lt;td style='text-align:left;padding-left:10px;'&gt;&lt;b&gt;ADR STATUS:&lt;/b&gt; &lt;span style='background:#DCFCE7;color:#14532D;padding:2px 8px;border-radius:4px;font-weight:800;'&gt;ACCEPTED&lt;/span&gt; &amp;nbsp;&amp;bull;&amp;nbsp; &lt;b&gt;Rationale:&lt;/b&gt; Option B delivers 20x throughput over Option A at 73% lower monthly cost than Option C.&lt;/td&gt;&lt;td style='text-align:right;padding-right:10px;color:#475569;font-weight:700;'&gt;Re-Evaluation Trigger: Sustained &amp;gt;75k RPS or Global Multi-Region Write Mandate&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Inter,Arial,sans-serif;fillColor=#F8FAFC;strokeColor=#CBD5E1;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="832" width="1536" height="42" as="geometry"/></mxCell>
