        <mxCell id="sod_b3" value="&lt;b style='color:#B91C1C;font-size:10px;'&gt;&amp;#10006; SoD Invariant 3&lt;br/&gt;Analyst &amp;ne; Auditor&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F87171;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1114" y="488" width="114" height="38" as="geometry"/></mxCell>
        <mxCell id="pep_box" value="&lt;table style='width:316px;border-collapse:collapse;font-family:Inter,Arial,sans-serif;'&gt;&lt;tr&gt;&lt;td style='padding:54px 12px 12px 12px;border-bottom:1.5px solid #0F172A;text-align:center;'&gt;&lt;div style='font-size:14px;font-weight:800;color:#0F172A;line-height:1.25;'&gt;OPA Rego &amp;amp; GCP IAM CEL&lt;br/&gt;Policy Enforcement Point (PEP)&lt;/div&gt;&lt;div style='font-size:10px;font-weight:600;color:#1E3A8A;margin-top:3px;'&gt;Evaluated Inline at Every Zone Transition&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:18px 16px;text-align:left;font-size:11.5px;color:#0F172A;line-height:1.52;'&gt;&lt;div style='margin-bottom:18px;'&gt;&lt;b&gt;&amp;bull; SoD Invariant 1 (Dual Custody):&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:monospace;font-size:10.5px;color:#1E293B;'&gt;request.auth.principal != resource.submitter&lt;/span&gt;&lt;br/&gt;Initiating requestor cannot approve own action.&lt;/div&gt;&lt;div style='margin-bottom:18px;'&gt;&lt;b&gt;&amp;bull; SoD Invariant 2 (Agent Containment):&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:monospace;font-size:10.5px;color:#1E293B;'&gt;!startsWith(principal, 'spiffe://')&lt;/span&gt;&lt;br/&gt;Autonomous ADK agents are cryptographically denied direct production commit roles.&lt;/div&gt;&lt;div style='margin-bottom:18px;'&gt;&lt;b&gt;&amp;bull; SoD Invariant 3 (Audit Independence):&lt;/b&gt;&lt;br/&gt;Mutually exclusive IAM group bindings between Operations Analysts and Compliance Auditors.&lt;/div&gt;&lt;div style='background:#EFF6FF;border:1px solid #93C5FD;padding:8px 10px;border-radius:6px;font-size:10.5px;'&gt;&lt;b&gt;JIT Elevation:&lt;/b&gt; Zone 3 requires Privileged Access Manager (PAM) 1h TTL + WebAuthn passkey.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1236" y="142" width="336" height="716" as="geometry"/></mxCell>
