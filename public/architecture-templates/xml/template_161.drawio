        <mxCell id="sod_b2" value="&lt;b style='color:#B91C1C;font-size:10px;'&gt;&amp;#10006; SoD Invariant 2&lt;br/&gt;Agent Denied Release&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F87171;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="686" y="527" width="128" height="30" as="geometry"/></mxCell>
