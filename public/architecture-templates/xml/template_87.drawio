        <mxCell id="j_ftr" value="&lt;table style='width:1524px;border-collapse:collapse;font-family:Inter,Arial,sans-serif;font-size:10.8px;color:#0F172A;'&gt;&lt;tr&gt;&lt;td style='text-align:left;padding-left:10px;'&gt;&lt;b&gt;SERVICE BLUEPRINT LINE OF VISIBILITY:&lt;/b&gt; Lanes 1–3 capture Human Persona UX; Lane 4 is Frontstage API/Edge; Lane 5 is Backstage Agentic &amp;amp; OTel Telemetry.&lt;/td&gt;&lt;td style='text-align:right;padding-right:10px;font-weight:700;color:#1D4ED8;'&gt;Single W3C traceparent Correlates All 5 Stages&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontColor=#0F172A;fontFamily=Inter,Arial,sans-serif;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="846" width="1546" height="34" as="geometry"/></mxCell>
