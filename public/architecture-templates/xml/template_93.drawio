ock;width:24px;&quot;&gt;&lt;/span&gt;published_at     TIMESTAMPTZ NULL&lt;/div&gt;&lt;div style=&quot;font-family:'Roboto Mono',monospace;font-size:11.2px;line-height:1.52;color:#3C4043;text-align:left;white-space:nowrap;&quot;&gt;&lt;span style=&quot;display:inline-block;width:24px;&quot;&gt;&lt;/span&gt;created_at       TIMESTAMPTZ DEFAULT now()&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="518" width="444" height="254" as="geometry"/></mxCell>
