{
  "name": "maestro-sketch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "validate": "npx tsx bin/validate-cli.ts",
    "validate:xml": "npx tsx bin/validate-cli.ts",
    "validate:blueprints": "npx tsx scripts/check-blueprint-catalog-quality.ts",
    "test": "vitest run",
    "eval:geometry": "tsx evals/score_geometry.ts",
    "eval:geometry:gate": "tsx evals/score_geometry.ts --baseline evals/results/geometry-baseline.json diagrams/latest/*.xml",
    "eval:templates": "tsx evals/check_template_integrity.ts templates/master_blueprints/xml/*.xml",
    "eval:templates:gate": "tsx evals/check_template_integrity.ts --allow evals/template-integrity-allowlist.json templates/master_blueprints/xml/*.xml"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "ajv": "^8.20.0",
    "docx": "^9.7.1",
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "canvas": "^3.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "gif-encoder-2": "^1.0.5",
    "puppeteer": "^25.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
