<mxCell id="p_fallbacks" value="&lt;div style=&quot;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:11px;color:#F59E0B;&quot;&gt;FALLBACK &amp;amp; ESCALATION PATHS&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;margin-top:6px;font-size:9px;color:#94A3B8;line-height:1.4;&quot;&gt;• &lt;b&gt;Low Confidence (&amp;lt;90%):&lt;/b&gt; Route to Human Review Task&lt;br/&gt;• &lt;b&gt;Unsupported Document:&lt;/b&gt; Return structured rejection error&lt;br/&gt;• &lt;b&gt;Ungrounded / Hallucination:&lt;/b&gt; Trigger clarifying query&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F1810;strokeColor=#F59E0B;strokeWidth=1.2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="185" width="270" height="105" as="geometry"/></mxCell>
<mxCell id="p_security" value="&lt;div style=&quot;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:11px;color:#10B981;&quot;&gt;SECURITY CONTROLS &amp;amp; COMPLIANCE&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;margin-top:6px;font-size:9px;color:#94A3B8;line-height:1.4;&quot;&gt;• &lt;b&gt;Data at Rest:&lt;/b&gt; Cloud KMS (CMEK) FIPS 140-3&lt;br/&gt;• &lt;b&gt;Data in Transit:&lt;/b&gt; TLS 1.3 Strict HTTPS Anycast&lt;br/&gt;• &lt;b&gt;Privacy:&lt;/b&gt; Sensitive Data Protection (DLP) inline masking&lt;br/&gt;• &lt;b&gt;Network:&lt;/b&gt; VPC Service Controls (VPC-SC) Perimeter&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0D1E17;strokeColor=#10B981;strokeWidth=1.2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="300" width="270" height="115" as="geometry"/></mxCell>
<mxCell id="p_steps" value="&lt;div style=&quot;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:11px;color:#A855F7;&quot;&gt;EXECUTION STEPS (1-12)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;margin-top:6px;font-size:8.5px;color:#94A3B8;line-height:1.4;&quot;&gt;1. User submits query / doc via web/mobile/bot&lt;br/&gt;2. GCLB &amp;amp; Armor filter DDoS &amp;amp; inspect TLS&lt;br/&gt;3. Identity Platform validates SSO / OAuth JWT&lt;br/&gt;4. BFF &amp;amp; Workflow Orchestrator create execution plan&lt;br/&gt;5. Document AI extracts OCR layout &amp;amp; tables&lt;br/&gt;6. Embeddings generated &amp;amp; indexed in Vector Search&lt;br/&gt;7. Hybrid search retrieves authorized context&lt;br/&gt;8. Gemini 2.5 Pro executes multi-step reasoning&lt;br/&gt;9. Agent tools invoke external enterprise MCP APIs&lt;br/&gt;10. Model Armor validates PII &amp;amp; confidence scores&lt;br/&gt;11. Verified answer streamed with verified citations&lt;br/&gt;12. Full audit trail recorded in Cloud Logging&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#191024;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="425" width="270" height="435" as="geometry"/></mxCell>
